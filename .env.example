# Set DATABASE_URL to a PostgreSQL connection reachable from inside the API container.
LOG_LEVEL=INFO
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
# Correo para los códigos de verificación (sin SMTP_HOST se escriben en el log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_STARTTLS=false
MAIL_FROM=Huellitas <no-reply@huellitas.local>
